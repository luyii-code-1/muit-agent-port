{
  "name": "muit-agent-port",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A lightweight MCP relay for coordinating Codex tasks across computers.",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:relay": "tsx watch src/relay/index.ts",
    "dev:bridge": "tsx watch src/bridge/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:relay": "node dist/relay/index.js",
    "start:bridge": "node dist/bridge/index.js",
    "pair:bridge": "node dist/bridge/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.11.1",
    "express": "5.1.0",
    "ws": "8.21.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  }
}
