# Relay server
MESH_HOST=127.0.0.1
MESH_PORT=8787
MESH_DB_PATH=./data/mesh.db
MESH_MCP_TOKEN=replace-with-a-long-random-token
# Optional static tokens; one-time pairing codes are easier and do not require this.
MESH_NODE_TOKENS={}
# Optional fallback shared token.
MESH_BRIDGE_TOKEN=
# Optional downloadable source bundle for new Bridge computers.
MESH_BRIDGE_PACKAGE_PATH=./releases/codex-mesh-mcp.zip

# Local bridge (set on each computer)
MESH_RELAY_URL=ws://127.0.0.1:8787/bridge
MESH_NODE_ID=macbook
# First start: use a six-digit code from the dashboard or codex_mesh_pairing_code.
MESH_PAIRING_CODE=123456
# Later starts read the saved credentials file automatically. Static tokens still work if preferred.
# MESH_NODE_TOKEN=replace-me
MESH_CREDENTIALS_PATH=./data/bridge-credentials.json
MESH_NODE_LABELS=macos,frontend
MESH_DEFAULT_CWD=/absolute/path/to/default/project
# Every cross-node task that starts a new conversation creates one empty project here.
MESH_INBOX_ROOT=/absolute/path/to/default/project/.codex-mesh/inbox
# Comma-separated absolute roots that remote tasks may use. Defaults to MESH_DEFAULT_CWD only.
MESH_ALLOWED_ROOTS=/absolute/path/to/default/project,/absolute/path/to/another/project
MESH_CODEX_COMMAND=codex
MESH_BRIDGE_CONCURRENCY=1
MESH_APPROVAL_POLICY=never
MESH_SANDBOX=workspace-write
MESH_THREAD_REFRESH_MS=30000
